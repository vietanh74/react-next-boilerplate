{
  "name": "react-next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "build:test": "NODE_ENV=test next build",
    "start": "next start",
    "types-check": "tsc --pretty --noEmit",
    "lint:partOfScript": "eslint -c eslint.config.mjs --quiet",
    "lint:script": "npm run lint:partOfScript --",
    "lint:partOfPrettier": "prettier --ignore-path .gitignore",
    "lint:prettier": "npm run lint:partOfPrettier -- \"src/**/*+(js|jsx|ts|tsx|scss)\"",
    "lint:partOfStyle": "stylelint --allow-empty-input -i .gitignore -i .stylelintignore",
    "lint:style": "npm run lint:partOfStyle -- src/**/*.{css,scss}",
    "lint": "npm run lint:style && npm run lint:prettier -- --check && npm run lint:script",
    "lintfix": "npm run lint:style -- --fix && npm run lint:prettier -- --write && npm run lint:script -- --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.2.0",
    "@reduxjs/toolkit": "^2.9.2",
    "antd": "^5.15.1",
    "axios": "^1.13.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.6",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-saga": "^1.4.2",
    "sass": "^1.93.2",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.2",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "stylelint": "^16.2.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:partOfScript"
    ],
    "*.{js,jsx,ts,tsx,css,scss}": [
      "npm run lint:partOfPrettier -- --check"
    ],
    "*.{css,scss}": [
      "npm run lint:partOfStyle"
    ]
  }
}
