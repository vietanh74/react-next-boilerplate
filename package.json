{
  "name": "react-next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--inspect next dev",
    "build": "next build",
    "build:testing": "env-cmd -f .env.testing next build",
    "start": "next start",
    "types-check": "tsc --pretty --noEmit",
    "lint:partOfScript": "eslint -c eslint.config.mjs --quiet",
    "lint:script": "npm run lint:partOfScript --",
    "lint:partOfPrettier": "prettier --ignore-path .gitignore --ignore-path .prettierignore",
    "lint:prettier": "npm run lint:partOfPrettier -- \"src/**/*+(js|jsx|ts|tsx|scss)\"",
    "lint:partOfStyle": "stylelint --allow-empty-input -i .gitignore -i .stylelintignore",
    "lint:style": "npm run lint:partOfStyle -- src/**/*.{css,scss}",
    "lint": "npm run lint:style && npm run lint:prettier -- --check && npm run lint:script",
    "lintfix": "npm run lint:style -- --fix && npm run lint:prettier -- --write && npm run lint:script -- --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@reduxjs/toolkit": "^2.9.2",
    "antd": "^6.3.1",
    "axios": "^1.13.6",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.2",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.23",
    "nanoid": "^5.1.6",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-saga": "^1.4.2",
    "sass": "^1.97.3",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^10.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "volta": {
    "node": "22.19.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:partOfScript"
    ],
    "*.{js,jsx,ts,tsx,css,scss}": [
      "npm run lint:partOfPrettier -- --check"
    ],
    "*.{css,scss}": [
      "npm run lint:partOfStyle"
    ]
  }
}
